NEXT_PUBLIC_PRODUCT_NAME="Agency Sales Copilot"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-side only. Do not expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-side only. Explicit selection; no automatic provider fallback.
AI_PROVIDER="groq"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"

# Used only when AI_PROVIDER="openai". Not required for Groq.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="your-openai-model"
